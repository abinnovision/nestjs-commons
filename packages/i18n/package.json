{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@abinnovision/nestjs-i18n",
	"version": "0.1.0",
	"description": "Type-safe backend i18n for NestJS with ICU MessageFormat catalogs, request locale resolution, and localized exceptions.",
	"keywords": [
		"nestjs",
		"i18n",
		"l10n",
		"localization",
		"icu",
		"messageformat",
		"translations"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/nestjs-commons.git",
		"directory": "packages/i18n"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./exceptions": {
			"import": {
				"types": "./dist/exceptions.d.mts",
				"default": "./dist/exceptions.mjs"
			},
			"require": {
				"types": "./dist/exceptions.d.cts",
				"default": "./dist/exceptions.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"format:check": "prettier --check 'src/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write 'src/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"lint:check": "eslint 'src/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.ts' --fix",
		"test-unit": "vitest --run --coverage --config vitest.config.mts",
		"test-unit:watch": "vitest --config vitest.config.mts"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "2.11.4",
		"intl-messageformat": "^10.7.18"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.1",
		"@abinnovision/nestjs-exceptions": "workspace:^",
		"@abinnovision/prettier-config": "^2.2.0",
		"@arethetypeswrong/core": "^0.18.3",
		"@nestjs/common": "^12.3.3",
		"@nestjs/core": "^12.3.3",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/testing": "^12.3.3",
		"@swc/core": "^1.16.1",
		"@types/node": "^26.4.0",
		"eslint": "^10.7.0",
		"prettier": "^3.8.4",
		"publint": "^0.3.21",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tsdown": "^0.22.2",
		"typescript": "^6.0.3",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@abinnovision/nestjs-exceptions": "^0.3.0",
		"@nestjs/common": "^11.0.0 || ^12.0.0",
		"@nestjs/core": "^11.0.0 || ^12.0.0"
	},
	"peerDependenciesMeta": {
		"@abinnovision/nestjs-exceptions": {
			"optional": true
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"ghpr": true,
		"npm": true,
		"npmAccess": "public"
	}
}
